# ==========================================
# 1. SUPABASE CREDENTIALS
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==========================================
# 2. LINE LOGIN (CHANNEL CREDENTIALS)
# ==========================================
# หาได้จาก https://developers.line.biz/ (LINE Developers Console)
LINE_CHANNEL_ID=your-line-channel-id
LINE_CHANNEL_SECRET=your-line-channel-secret

# Callback URL สำหรับรับรหัสยืนยันจาก LINE
# (ต้องตรงกับ Callback URL ที่ตั้งไว้ใน LINE Developers Console)
NEXT_PUBLIC_LINE_REDIRECT_URI=http://localhost:3000/api/auth/line/callback
